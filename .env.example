# FieldAgentLog - local development env. Copy to .env and fill in.
#
# EXPO_PUBLIC_* values are inlined into the bundle at build time and visible to
# anyone holding the app. Publishable key ONLY - never a service-role key.
# Builds don't read .env: preview/production get env from eas.json + `eas env`.

# Local BalanceBuddy stack: run `supabase start` in ../../balancebuddy-web,
# then paste the anon/publishable key printed by `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional - derived from EXPO_PUBLIC_SUPABASE_URL when unset
# (hosted: <ref>.functions.supabase.co; local: <url>/functions/v1).
# EXPO_PUBLIC_FUNCTIONS_BASE_URL=
