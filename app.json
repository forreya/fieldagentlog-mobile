{
	"expo": {
		"name": "FieldAgentLog",
		"slug": "fieldagentlog",
		"version": "1.0.1",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "fieldagentlog",
		"userInterfaceStyle": "light",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.fieldagentlog.app",
			"supportsTablet": false,
			"associatedDomains": [
				"applinks:fieldagentlog.com"
			],
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.fieldagentlog.app",
			"blockedPermissions": [
				"android.permission.ACCESS_BACKGROUND_LOCATION",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.RECORD_AUDIO",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.VIBRATE",
				"android.permission.WRITE_EXTERNAL_STORAGE"
			],
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [
						{
							"scheme": "https",
							"host": "fieldagentlog.com",
							"pathPrefix": "/v/"
						}
					],
					"category": [
						"BROWSABLE",
						"DEFAULT"
					]
				}
			]
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76
				}
			],
			"expo-font",
			"expo-sqlite",
			[
				"expo-secure-store",
				{
					"faceIDPermission": false
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "FieldAgentLog uses your photos so you can attach an existing picture to a fire-safety check or an issue you're reporting.",
					"cameraPermission": "FieldAgentLog uses the camera so you can photograph a fault on a fire-safety check or an issue you're reporting.",
					"microphonePermission": false
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "FieldAgentLog uses your location when you check in or out of a site, when you report an issue, and when you ask it to sort blocks by distance. It is never used in the background.",
					"locationAlwaysAndWhenInUsePermission": false,
					"locationAlwaysPermission": false,
					"motionUsagePermission": "FieldAgentLog's location component may use motion to sharpen the accuracy of a check-in or check-out fix. The app never tracks your movement and never stores motion data.",
					"isIosBackgroundLocationEnabled": false,
					"isAndroidBackgroundLocationEnabled": false
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "900e462b-99b3-404c-8e4a-2023cc4ba68f"
			}
		},
		"owner": "forreya",
		"updates": {
			"url": "https://u.expo.dev/900e462b-99b3-404c-8e4a-2023cc4ba68f",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0
		},
		"runtimeVersion": {
			"policy": "fingerprint"
		}
	}
}
